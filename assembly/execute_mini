
# Exercises: the program only returns a value 32 as output. You can check it by running:
# $ ./mini; echo $?
# 32


# Compile with gcc:
echo "[+] Compilation with gcc (includes libc):"
gcc -o mini_c mini.c
echo "[+] Result of execution with C:" 
./mini_c; echo $?

# Compilation in ASM
echo "[+] Compilation with ASM (without libc):" 
nasm -f elf32 -o mini_asm.o mini.asm
ld -m elf_i386 -o mini_asm mini_asm.o
echo "[+] Result of execution"
./mini_asm; echo $? 
echo "[+] Comparison of executable sizes:"
ls -l mini_c mini_asm

