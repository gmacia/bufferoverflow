# $ ./miniprograma; echo $?
# 32


# Compile with gcc:
echo "[+] Compilation with gcc (includes libc):"
gcc -o miniprograma_c miniprograma.c
echo "[+] Result of execution with C:" 
./miniprograma_c; echo $?

# Compilation in ASM
echo "[+] Compilation with ASM (without libc):" 
nasm -f elf32 -o miniprograma_asm.o miniprograma.asm
ld -m elf_i386 -o miniprograma_asm miniprograma_asm.o
echo "[+] Result of execution"
./miniprograma_asm; echo $? 
echo "[+] Comparison of executable sizes:"
ls -l miniprograma_c miniprograma_asm

